{"id":"duoergun","name":"多尔衮","born":{"year":1612,"certainty":"确知"},"died":{"year":1650,"certainty":"确知"},"lifeSpan":38,"thesis":"摄政王，入关定鼎北京。","sources":[{"label":"《清史稿·列传五 诸王四》","url":"https://zh.wikisource.org/wiki/%E6%B8%85%E5%8F%B2%E7%A8%BF%2F%E5%8D%B7218"}],"events":[{"year":1612,"age":0,"yearCertainty":"确知","kind":"stage","title":"生于赫图阿拉","tier":"布衣","tierScore":35,"crisis":"平稳","crisisPenalty":0,"score":35,"delta":0,"rationale":"王子","summary":"努尔哈赤十四子","evidence":"原文","quote":{"t":"睿忠亲王多尔衮，太祖第十四子。","s":0}},{"year":1626,"age":14,"yearCertainty":"确知","kind":"stage","title":"母被逼殉葬","tier":"布衣","tierScore":30,"crisis":"大败","crisisPenalty":20,"score":10,"delta":-25,"rationale":"家难","summary":"阿巴亥殉葬","evidence":"概括","quote":null},{"year":1636,"age":24,"yearCertainty":"确知","kind":"stage","title":"封睿亲王","tier":"重臣主帅","tierScore":84,"crisis":"平稳","crisisPenalty":0,"score":84,"delta":74,"rationale":"亲王","summary":"亲王","evidence":"原文","quote":{"t":"崇德元年，进封睿亲王。","s":0}},{"year":1643,"age":31,"yearCertainty":"确知","kind":"stage","title":"拥立福临为摄政王","tier":"一方之主","tierScore":90,"crisis":"平稳","crisisPenalty":0,"score":90,"delta":6,"rationale":"摄政","summary":"摄政","evidence":"原文","quote":{"t":"上至京师，封为叔父摄政王，赐貂蟒朝衣。","s":0}},{"year":1644,"age":32,"yearCertainty":"确知","kind":"stage","title":"入关定鼎北京","tier":"天下共主","tierScore":95,"crisis":"平稳","crisisPenalty":0,"score":95,"delta":5,"rationale":"巅峰","summary":"山海关","evidence":"原文","quote":{"t":"五月，率诸王贝勒猎于山海关，朝鲜送女至，王迎于连山，成婚。","s":0}}],"finale":{"year":1650,"age":38,"title":"猝死","retention":0.95,"reason":"身后被削爵","score":90.3,"evidence":"原文","quote":{"t":"十二月，薨于喀喇城，年三十九。","s":0},"verified":true},"posthumous":[{"year":1651,"title":"被追夺封号，削爵毁墓","score":35,"rationale":"","inferred":false},{"year":1778,"title":"乾隆平反复爵","score":68,"rationale":"","inferred":false},{"year":2026,"title":"今日评价","score":74,"rationale":"入关的实际统帅","inferred":false}],"legacy":{"tier":"重要人物","score":74,"label":"争议","rationale":"入关的实际统帅"},"peak":{"title":"入关定鼎北京","age":32,"score":95},"trough":{"title":"母被逼殉葬","age":14,"score":10},"gaps":[],"wikiIntro":"多尔衮（满语：ᡩᠣᡵᡤᠣᠨ，穆麟德转写：Dorgon，1612年11月17日—1650年12月31日），满洲爱新觉罗氏，清朝初年宗室、皇父摄政王、权臣、八旗领袖、清朝入关后奠基者之一，曾一度追尊为皇帝，庙号“成宗”，谥号“懋德修道广业定功安民立政诚敬义皇帝”。清太祖努尔哈赤第十四子，清太宗皇太极之弟，清世祖福临的叔父，母为清太祖努尔哈赤大妃阿巴亥（乌拉纳喇氏），同母兄英亲王阿济格，同母弟豫亲王多铎。初称台吉。1626年封贝勒，后因战功封“和硕睿亲王”。顺治朝初年实际上最高领导人，多尔衮清军入关，对巩固清朝在中原统始、统一中原、满人汉化起了关键作用，奠定满清往后200多年在中原的统治基础。今北京故宫东侧南池子大街东侧的普度寺，即原为多尔衮在北京城的宅邸。"}