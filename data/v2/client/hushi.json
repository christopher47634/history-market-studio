ence":"百科","quote":{"t":"1948年3月，胡适当选为中央研究院第一届院士。","s":0}},{"year":1949,"age":58,"yearCertainty":"确知","kind":"stage","title":"离开大陆","tier":"成名","tierScore":50,"crisis":"大败","crisisPenalty":20,"score":30,"delta":-38,"rationale":"去国","summary":"赴美，寓居纽约","evidence":"概括","quote":null},{"year":1954,"age":63,"yearCertainty":"确知","kind":"sub","title":"大陆批判胡适思想","tier":"成名","tierScore":48,"crisis":"受挫","crisisPenalty":5,"score":43,"delta":0,"rationale":"被批判","summary":"全国性批判运动","evidence":"概括","quote":null},{"year":1958,"age":67,"yearCertainty":"确知","kind":"stage","title":"中研院院长","tier":"重臣主帅","tierScore":78,"crisis":"平稳","crisisPenalty":0,"score":78,"delta":48,"rationale":"学术","summary":"台北","evidence":"概括","quote":null},{"year":1960,"age":69,"yearCertainty":"确知","kind":"sub","title":"雷震案","tier":"方面名家","tierScore":62,"crisis":"受挫","crisisPenalty":5,"score":57,"delta":0,"rationale":"无力","summary":"为雷震求情未果","evidence":"百科","quote":{"t":"1960年9月，雷震因“共谍”案被捕，即雷震事件，而此事件一般认为是蒋介石为阻止雷震筹组新党而策划。","s":0}}],"finale":{"year":1962,"age":71,"title":"酒会上猝逝台北","retention":0.95,"reason":"白话文","score":74.1,"evidence":"百科","quote":{"t":"参与中央研究院第五届院士欢迎酒会时，心脏病突发病逝于台北县南港镇（今台北市南港区）时胡正在讲台上致词演说","s":0},"verified":true},"posthumous":[{"year":2026,"title":"今日评价","score":90,"rationale":"新文化运动领袖","inferred":true}],"legacy":{"tier":"时代定义者","score":90,"label":"争议","rationale":"新文化运动领袖"},"peak":{"title":"驻美大使","age":47,"score":78},"trough":{"title":"离开大陆","age":58,"score":30},"gaps":[{"fromAge":0,"toAge":19,"years":19}],"wikiIntro":"胡适（1891年12月17日—1962年2月24日），原名嗣穈，学名洪骍，又改名适，字适之。用过的笔名有：希彊、自胜生、铁儿、冬心、臧晖之主人、臧晖等。生于江苏省松江府川沙厅，籍贯安徽省徽州府绩溪县上庄镇。曾任国立北京大学校长、中央研究院院长、中华民国驻美大使；天主教辅仁大学、南开大学校董会董事等职。胡适是新文化运动的奠基人与领袖之一，他兴趣广泛，著述丰富，在文学、哲学、史学、考据学、教育学、伦理学、红学等诸多领域都有较为深入的研究，开风气之先。在哲学上倡导约翰·杜威的实用主义方法论，主张“大胆假设，细心实证”，“实验是真理的唯一试金石”，在政治上主张自由主义。他是一位备受争议、值得探讨的多重身份历史人物，也是被各方政治势力批评得最多的人之一。"}