ore":90,"rationale":"","inferred":false},{"year":2026,"title":"今日评价","score":90,"rationale":"兵家鼻祖，姜太公","inferred":false}],"legacy":{"tier":"时代定义者","score":90,"label":"正面","rationale":"兵家鼻祖，姜太公"},"peak":{"title":"封于齐","age":83,"score":88},"trough":{"title":"穷困垂钓","age":68,"score":3},"gaps":[{"fromAge":0,"toAge":68,"years":68},{"fromAge":83,"toAge":113,"years":30}],"wikiIntro":"太公望，姓姜，氏吕，名尚，字子牙，是周文王、周武王的军师，史册记载名字有姜尚、姜望、姜牙、姜子牙、吕尚、吕望、吕涓、吕牙，别称有姜太公、吕太公、齐太公、太公、太公望、尚父、师尚父，庙号文祖甲齐公，又被追封为武成王、昭烈武成王。太公望辅佐周朝取代殷商有功，受封于齐国，是姜齐的始祖，也因其战功，被后代视为武圣、兵家之圣，唐初起设置武成王庙，主祀吕尚，仪典与文庙相同。民间传说称太公望在商朝时当过小官，商末民不聊生，纣王暴政年年，太公望辞官离开商都朝歌，隐居于蟠溪峡。据说曾在磁泉边以长杆、短线、直勾、背身的奇妙方式钓鱼，因而有“姜太公钓鱼——愿者上钩”之说法。"}