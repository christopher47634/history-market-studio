{"id":"lizhi","name":"李贽","born":{"year":1527,"certainty":"确知"},"died":{"year":1602,"certainty":"确知"},"lifeSpan":75,"thesis":"异端思想家，童心说，死于狱中。","sources":[{"label":"《明史·卷二百二十一列传第一百〇九 袁洪愈 王廷瞻 郭应聘 耿定向 王樵 魏时亮 郝杰 赵参鲁 张孟男 李祯 丁宾》","url":"https://zh.wikisource.org/wiki/%E6%98%8E%E5%8F%B2%2F%E5%8D%B7221"}],"events":[{"year":1527,"age":0,"yearCertainty":"确知","kind":"stage","title":"生于泉州","tier":"布衣","tierScore":18,"crisis":"平稳","crisisPenalty":0,"score":18,"delta":0,"rationale":"平民","summary":"回族商人家庭","evidence":"概括","quote":null},{"year":1552,"age":25,"yearCertainty":"确知","kind":"stage","title":"举人","tier":"初起","tierScore":30,"crisis":"平稳","crisisPenalty":0,"score":30,"delta":12,"rationale":"入仕","summary":"举人","evidence":"概括","quote":null},{"year":1577,"age":50,"yearCertainty":"确知","kind":"stage","title":"姚安知府","tier":"成名","tierScore":50,"crisis":"平稳","crisisPenalty":0,"score":50,"delta":20,"rationale":"地方官","summary":"知府","evidence":"原文","quote":{"t":"贽为姚安知府，一旦自去其发，冠服坐堂皇，上官勒令解任。","s":0}},{"year":1580,"age":53,"yearCertainty":"确知","kind":"stage","title":"弃官讲学","tier":"成名","tierScore":44,"crisis":"平稳","crisisPenalty":0,"score":44,"delta":-6,"rationale":"讲学","summary":"麻城芝佛院","evidence":"概括","quote":null},{"year":1590,"age":63,"yearCertainty":"确知","kind":"stage","title":"刊《焚书》","tier":"成名","tierScore":50,"crisis":"平稳","crisisPenalty":0,"score":50,"delta":6,"rationale":"名著","summary":"童心说","evidence":"概括","quote":null},{"year":1602,"age":75,"yearCertainty":"确知","kind":"stage","title":"被劾下狱","tier":"初起","tierScore":35,"crisis":"绝境","crisisPenalty":55,"score":2,"delta":-48,"rationale":"死局","summary":"惑世诬民","evidence":"原文","quote":{"t":"后北游通州，为给事中张问达所劾，逮死狱中。","s":0}}],"finale":{"year":1602,"age":75,"title":"狱中自刎","retention":0.8,"reason":"著作被禁","score":1.6,"evidence":"概括","quote":null,"verified":false},"posthumous":[{"year":1900,"title":"近代推为思想解放先驱","score":72,"rationale":"","inferred":false},{"year":2026,"title":"今日评价","score":78,"rationale":"明代异端思想家","inferred":false}],"legacy":{"tier":"一代名家","score":78,"label":"争议","rationale":"明代异端思想家"},"peak":{"title":"姚安知府","age":50,"score":50},"trough":{"title":"被劾下狱","age":75,"score":2},"gaps":[{"fromAge":0,"toAge":25,"years":25},{"fromAge":25,"toAge":50,"years":25}],"wikiIntro":"李贽（zhì）（1527年11月19日—1602年5月7日），初姓林，名载贽，后改姓李，改名贽，字宏甫，号卓吾，又号温陵居士、笃吾、百泉居士、宏父、思斋、龙湖叟、秃翁等，出身福建布政司泉州府晋江县，活跃于明朝万历时期之思想家。他致力于激烈批评和反思儒家与士大夫之思想、行为及价值观等，并因而在明朝晚期之思想变化潮流中引发热烈争议与关注。他否定传统儒学等规范之绝对地位，肯定个人的思辨和感知能力，但称这种能力必须出于他所提出之概念“童心”。他的代表著作有《焚书》、《续焚书》、《藏书》等。"}