ationale":"国破","summary":"秦将白起拔郢，作《哀郢》","evidence":"概括","quote":null}],"finale":{"year":-278,"age":62,"title":"怀石投汨罗","retention":0.9,"reason":"《离骚》流传千古","score":1.8,"evidence":"原文","quote":{"t":"于是怀石遂自（投）［沈］汨罗以死。","s":0},"verified":true},"posthumous":[{"year":-174,"title":"贾谊作《吊屈原赋》","score":70,"rationale":"","inferred":false},{"year":-91,"title":"《史记》立屈原贾生列传","score":80,"rationale":"","inferred":false},{"year":960,"title":"端午纪念屈原成为习俗","score":90,"rationale":"","inferred":false},{"year":2026,"title":"今日评价","score":95,"rationale":"中国第一位伟大诗人，楚辞之祖","inferred":false}],"legacy":{"tier":"文明塑造者","score":95,"label":"正面","rationale":"中国第一位伟大诗人，楚辞之祖"},"peak":{"title":"任左徒","age":22,"score":62},"trough":{"title":"顷襄王时放逐江南","age":44,"score":2},"gaps":[{"fromAge":0,"toAge":22,"years":22},{"fromAge":44,"toAge":62,"years":18}],"wikiIntro":"屈原（约前340年－前278年），芈姓，屈氏，名平，字原，是中国战国时期楚国的诗人、政治人物。现存最早提及屈原的作品是西汉贾谊的《吊屈原赋》；司马迁《史记·屈原贾生列传》则是现存最早的系统传记，但其中的年代与事迹存在若干矛盾。据《史记》记载，屈原出身楚国宗室，曾任左徒，参与楚怀王时期的内政与外交，主张联齐抗秦，后遭疏远并被放逐。前278年，秦将白起攻破楚都郢。据《史记》记载，屈原此后作《怀沙》，投汨罗江而死。屈原是《楚辞》传统的核心人物。《离骚》通常被视为其代表作；《九歌》《天问》《九章》等篇的具体作者归属则有不同看法。端午节的龙舟竞渡与食粽习俗，在后世传说中逐渐与屈原之死相联系。"}