{"id":"wangxizhi","name":"王羲之","born":{"year":303,"certainty":"确知"},"died":{"year":361,"certainty":"确知"},"lifeSpan":58,"thesis":"琅琊王氏子弟，书圣，兰亭集序天下第一行书。","sources":[{"label":"《晋书·卷八十 列传第五十》","url":"https://zh.wikisource.org/wiki/%E6%99%89%E6%9B%B8%2F%E5%8D%B7080"}],"events":[{"year":303,"age":0,"yearCertainty":"确知","kind":"stage","title":"生于琅琊","tier":"布衣","tierScore":32,"crisis":"平稳","crisisPenalty":0,"score":32,"delta":0,"rationale":"顶级士族","summary":"王导从子","evidence":"概括","quote":null},{"year":330,"age":27,"yearCertainty":"估计","kind":"stage","title":"东床坦腹","tier":"布衣","tierScore":32,"crisis":"平稳","crisisPenalty":0,"score":32,"delta":0,"rationale":"名士","summary":"郗鉴择婿，羲之坦腹东床","evidence":"原文","quote":{"t":"惟一人在东床坦腹食，独若不闻。","s":0}},{"year":345,"age":42,"yearCertainty":"估计","kind":"stage","title":"任右军将军","tier":"成名","tierScore":52,"crisis":"平稳","crisisPenalty":0,"score":52,"delta":20,"rationale":"名流官员","summary":"为右军将军、会稽内史","evidence":"原文","quote":{"t":"羲之既拜护军，又苦求宣城郡，不许，乃以为右军将军、会稽内史。","s":0}},{"year":353,"age":50,"yearCertainty":"确知","kind":"stage","title":"兰亭雅集","tier":"方面名家","tierScore":60,"crisis":"平稳","crisisPenalty":0,"score":60,"delta":8,"rationale":"书法巅峰","summary":"修禊兰亭，作序","evidence":"原文","quote":{"t":"尝与同志宴集于会稽山阴之兰亭，羲之自为之序以申其志，曰：","s":0}},{"year":355,"age":52,"yearCertainty":"确知","kind":"stage","title":"誓墓辞官","tier":"方面名家","tierScore":56,"crisis":"平稳","crisisPenalty":0,"score":56,"delta":-4,"rationale":"归隐","summary":"与王述不和，誓墓不仕","evidence":"概括","quote":null}],"finale":{"year":361,"age":58,"title":"卒","retention":0.95,"reason":"书法被尊为书圣","score":53.2,"evidence":"概括","quote":null,"verified":false},"posthumous":[{"year":630,"title":"唐太宗推崇，兰亭入昭陵","score":95,"rationale":"","inferred":false},{"year":2026,"title":"今日评价","score":95,"rationale":"书圣","inferred":false}],"legacy":{"tier":"文明塑造者","score":95,"label":"正面","rationale":"书圣"},"peak":{"title":"兰亭雅集","age":50,"score":60},"trough":{"title":"东床坦腹","age":27,"score":32},"gaps":[{"fromAge":0,"toAge":27,"years":27}],"wikiIntro":"王羲之（303年—361年），字逸少，琅邪郡临沂县（今山东省临沂市）人，淮南太守王旷之子，官拜右军将军，人称王右军。为王导之侄，是东晋时期的书法家，人称书圣，与书法家锺繇合称为“锺王”。其书法师承卫夫人（卫夫人则师承锺繇）王羲之的书法实践，变当时流行的章草、八分为今草、行书、楷书，是书体转换时期平地而起的高峰。其书法尺牍散见于唐朝的精摹本《十七帖》、《快雪时晴帖》、现藏于日本的《丧乱帖》、《孔侍中帖》等名品。王羲之的书法真迹皆已失传，其作品《兰亭集序》等帖，均为后人临摹。"}