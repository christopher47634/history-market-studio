{"id":"wanyanliang","name":"完颜亮","born":{"year":1122,"certainty":"确知"},"died":{"year":1161,"certainty":"确知"},"lifeSpan":39,"thesis":"海陵王，弑君篡位，迁都燕京，南侵兵败被杀。","sources":[{"label":"《金史·卷五 本纪第五 海陵》","url":"https://zh.wikisource.org/wiki/%E9%87%91%E5%8F%B2%2F%E5%8D%B75"}],"events":[{"year":1122,"age":0,"yearCertainty":"确知","kind":"stage","title":"生于金朝宗室","tier":"布衣","tierScore":35,"crisis":"平稳","crisisPenalty":0,"score":35,"delta":0,"rationale":"宗室","summary":"太祖之孙","evidence":"概括","quote":null},{"year":1149,"age":27,"yearCertainty":"确知","kind":"stage","title":"弑熙宗篡位","tier":"一方之主","tierScore":90,"crisis":"平稳","crisisPenalty":0,"score":90,"delta":55,"rationale":"篡位","summary":"即位","evidence":"原文","quote":{"t":"是夜，兴国取符钥启门纳海陵、秉德、辩、乌带、徒单贞、李老僧等人至寝殿，遂弑熙宗。","s":0}},{"year":1153,"age":31,"yearCertainty":"确知","kind":"stage","title":"迁都燕京","tier":"一方之主","tierScore":92,"crisis":"平稳","crisisPenalty":0,"score":92,"delta":2,"rationale":"改革","summary":"建中都","evidence":"原文","quote":{"t":"四月丙午，诏迁都燕京。","s":0}},{"year":1161,"age":39,"yearCertainty":"确知","kind":"stage","title":"南侵采石之败","tier":"一方之主","tierScore":88,"crisis":"大败","crisisPenalty":30,"score":58,"delta":-34,"rationale":"败","summary":"虞允文败之","evidence":"概括","quote":null},{"year":1161,"age":39,"yearCertainty":"确知","kind":"stage","title":"被部将所杀","tier":"一方之主","tierScore":85,"crisis":"绝境","crisisPenalty":60,"score":25,"delta":-33,"rationale":"死","summary":"完颜元宜杀之","evidence":"原文","quote":{"t":"乙未，浙西兵马都统制完颜元宜等军反，帝遇弑，崩，年四十。","s":0}}],"finale":{"year":1161,"age":39,"title":"被杀，废为庶人","retention":0.8,"reason":"金世宗即位","score":20,"evidence":"概括","quote":null,"verified":false},"posthumous":[{"year":2026,"title":"今日评价","score":50,"rationale":"金海陵王","inferred":true}],"legacy":{"tier":"有影响","score":50,"label":"负面","rationale":"金海陵王"},"peak":{"title":"迁都燕京","age":31,"score":92},"trough":{"title":"被部将所杀","age":39,"score":25},"gaps":[{"fromAge":0,"toAge":27,"years":27}],"wikiIntro":"完颜亮（1122年2月24日—1161年12月15日），字元功，女真名迪古乃，金朝第四任皇帝（1150年1月9日－1161年12月15日在位）。完颜亮称金废帝或海陵王。金太祖完颜阿骨打之孙，太祖庶长子完颜宗干次子，母亲为大氏。金熙宗朝，完颜亮官至右丞相兼都元帅、太保领三省事，位极人臣。皇统九年末（1150年），完颜亮刺杀堂兄熙宗，即位改元。登基后，大肆屠杀宗室，使太宗一脉断绝。在位期间，废除行台尚书省，直接管理华北；迁国都、祖陵至燕京（今北京），改称中都；设立国子监，改革科举；印制交钞、铜钱；颁行正隆官制，废除徒有虚名的三省制，只设尚书省；南迁大批猛安谋克至中原。金末元好问称之为“天德小康”。完颜亮一心攻宋，不顾实际地超限度举国征伐，导致国内民变蜂起。正隆六年（1161年），发兵全面攻宋，亲率大军渡过淮河。"}