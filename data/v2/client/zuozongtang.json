arCertainty":"确知","kind":"stage","title":"樊燮案","tier":"成名","tierScore":40,"crisis":"绝境","crisisPenalty":40,"score":2,"delta":-48,"rationale":"险境","summary":"险被杀","evidence":"原文","quote":{"t":"会秉章劾罢总兵樊燮，燮构于总督官文，为蜚语上闻，召宗棠对簿武昌，秉章疏争之不得。","s":0}},{"year":1860,"age":48,"yearCertainty":"确知","kind":"stage","title":"募楚军","tier":"成名","tierScore":54,"crisis":"平稳","crisisPenalty":0,"score":54,"delta":52,"rationale":"领兵","summary":"以四品京堂襄办曾国藩军务","evidence":"概括","quote":null},{"year":1862,"age":50,"yearCertainty":"确知","kind":"sub","title":"浙江巡抚","tier":"重臣主帅","tierScore":76,"crisis":"平稳","crisisPenalty":0,"score":76,"delta":0,"rationale":"督抚","summary":"转战浙江","evidence":"概括","quote":null},{"year":1863,"age":51,"yearCertainty":"确知","kind":"stage","title":"闽浙总督","tier":"重臣主帅","tierScore":84,"crisis":"平稳","crisisPenalty":0,"score":84,"delta":30,"rationale":"督抚","summary":"方面","evidence":"概括","quote":null},{"year":1866,"age":54,"yearCertainty":"确知","kind":"stage","title":"创福州船政局","tier":"重臣主帅","tierScore":84,"crisis":"平稳","crisisPenalty":0,"score":84,"delta":0,"rationale":"洋务","summary":"洋务","evidence":"概括","quote":null},{"year":1867,"age":55,"yearCertainty":"确知","kind":"stage","title":"陕甘总督","tier":"重臣主帅","tierScore":84,"crisis":"平稳","crisisPenalty":0,"score":84,"delta":0,"rationale":"督抚","summary":"西征平定陕甘回乱","evidence":"概括","quote":null},{"year":1873,"age":61,"yearCertainty":"确知","kind":"sub","title":"平定陕甘","tier":"重臣主帅","tierScore":84,"crisis":"平稳","crisisPenalty":0,"score":84,"delta":0,"rationale":"战功","summary":"肃州克复","evidence":"百科","quote":{"t":"1873年九月，甘肃西北部肃州回军首领马文禄在坚守肃州城两年后也接近粮尽，向左宗棠投降。","s":1}},{"year":1875,"age":63,"yearCertainty":"确知","kind":"stage","title":"督办新疆军务","tier":"一方之主","tierScore":86,"crisis":"平稳","crisisPenalty":0,"score":86,"delta":2,"rationale":"钦差","summary":"海防塞防之争胜出","evidence":"百科","quote":{"t":"光绪元年（1875年），朝廷上争议出兵收复新疆，引起“海防”与“塞防”之争。","s":1}},{"year":1878,"age":66,"yearCertainty":"确知","kind":"stage","title":"收复新疆","tier":"一方之主","tierScore":88,"crisis":"平稳","crisisPenalty":0,"score":88,"delta":2,"rationale":"巅峰","summary":"抬棺","evidence":"概括","quote":null},{"year":1881,"age":69,"yearCertainty":"确知","kind":"sub","title":"入值军机处","tier":"重臣主帅","tierScore":84,"crisis":"受挫","crisisPenalty":5,"score":79,"delta":0,"rationale":"京官","summary":"与同僚不合，外放两江","evidence":"概括","quote":null},{"year":1882,"age":70,"yearCertainty":"确知","kind":"sub","title":"奏请新疆建省","tier":"重臣主帅","tierScore":84,"crisis":"平稳","crisisPenalty":0,"score":84,"delta":0,"rationale":"经营","summary":"两江总督","evidence":"百科","quote":{"t":"左宗棠再次向清朝政府奏请新疆建省，提出乘新疆收复伊始和西征大军未撤之威","s":1}},{"year":1884,"age":72,"yearCertainty":"确知","kind":"stage","title":"督办福建军务","tier":"重臣主帅","tierScore":82,"crisis":"受挫","crisisPenalty":5,"score":77,"delta":-11,"rationale":"老病出征","summary":"中法战争","evidence":"概括","quote":null}],"finale":{"year":1885,"age":73,"title":"卒于福州","retention":0.95,"reason":"新疆建省","score":73.1,"evidence":"原文","quote":{"t":"四年正月，条上新疆建行省事宜，并请与俄议还伊犁、交叛人二事。","s":0},"verified":true},"posthumous":[{"year":2026,"title":"今日评价","score":88,"rationale":"收复新疆","inferred":true}],"legacy":{"tier":"时代定义者","score":88,"label":"正面","rationale":"收复新疆"},"peak":{"title":"收复新疆","age":66,"score":88},"trough":{"title":"樊燮案","age":47,"score":2},"gaps":[{"fromAge":0,"toAge":20,"years":20},{"fromAge":20,"toAge":40,"years":20}],"wikiIntro":"左宗棠（1812年11月10日—1885年9月5日），字季高，号湘上农人，署名今亮，谥文襄，湖南湘阴人，晚清重臣、湘军将领、政治家、文学家、军事家、外交家、实业家、改革家、诗人，洋务派代表人物之一。一生亲历了讨伐太平天国、洋务运动、陕甘回变、新疆之役等重要中国历史事件。在中法战争马尾海战后，以钦差大臣之名重整湘军督办福建、台湾海疆防务期间，病逝于福州，享寿73岁。宗棠少时屡试不第，功名止于举人，在醴陵渌江书院主讲二年，转而遍读群书，留意水利、农业，钻研舆地、兵法。后因军功破格免试敕赐同进士出身，官至东阁大学士、军机大臣、一等轻车都尉，封二等恪靖侯。与曾国藩、李鸿章、张之洞，并称“晚清四大名臣”。"}