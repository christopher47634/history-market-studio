{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "maxNodeModuleJsDepth": 0,
    "strict": false,
    "strictNullChecks": true,
    "noImplicitThis": true,
    "noFallthroughCasesInSwitch": true
  },
  "files": [
    "src/types.d.ts",
    "src/trajectoryModel.js",
    "src/marketEngine.js",
    "src/hash.js",
    "src/data.js",
    "src/server/historyApi.js",
    "src/v2/model.js",
    "src/v3/scene.js",
    "src/v3/detail.js",
    "src/v3/boards.js"
  ]
}
