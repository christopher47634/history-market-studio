{
  "name": "history-market-studio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test:data": "node scripts/validate-data.mjs",
    "test:schema": "node scripts/validate-schema.mjs && node --test tests/schema.test.mjs",
    "test:trajectories": "node scripts/audit-terminal-trajectories.mjs",
    "test:ui": "node scripts/validate-ui-contract.mjs",
    "test:production": "node scripts/validate-production.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "audit:sources": "node scripts/audit-source-links.mjs",
    "v2:fetch": "node pipeline/fetch-sources.mjs",
    "v2:build": "node pipeline/build.mjs",
    "v2:review": "node pipeline/review.mjs",
    "test:v2": "node --test tests/pipeline.test.mjs",
    "test:lab": "node tests/e2e-lab.mjs",
    "test:app": "node tests/e2e-app.mjs",
    "test:cross": "node tests/e2e-cross.mjs",
    "test:static": "npm run test:data && npm run test:schema && npm run test:trajectories && npm run test:ui && npm run test:v2",
    "v2:pin-wiki": "node pipeline/pin-wiki.mjs",
    "v2:audit": "node pipeline/audit-consistency.mjs --modern",
    "v2:portraits": "node pipeline/fetch-portraits.mjs && python pipeline/roles.py",
    "v2:fonts": "python pipeline/fonts.py",
    "test:algorithms": "node --test tests/algorithms.test.mjs",
    "test:search": "node --test tests/search.test.mjs",
    "test": "npm run typecheck && npm run test:static && npm run test:sites && npm run test:algorithms && npm run test:search",
    "typecheck": "tsc -p jsconfig.json"
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "lucide-react": "^1.59.0",
    "motion": "^12.43.0",
    "overlayscrollbars": "^2.16.0",
    "overlayscrollbars-react": "^0.5.6",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "5.0.4",
    "esbuild": "^0.25.10",
    "opencc-js": "^1.4.2",
    "playwright": "^1.63.0",
    "typescript": "^5.6.3",
    "vite": "6.4.3"
  }
}
